# Variáveis de ambiente do backend — copie este arquivo para .env e preencha os valores

# ── MQTT ──────────────────────────────────────────────────────────────────────
# Mosquitto local (padrão). Para usar broker público: broker.hivemq.com
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=quadra/highlight
MQTT_CLIENT_ID=smart-court-backend

# ── InfluxDB 2.x ──────────────────────────────────────────────────────────────
INFLUX_URL=http://localhost:8086
# ⚠️  Obrigatório: gere o token em http://localhost:8086 → Load Data → API Tokens
INFLUX_TOKEN=seu_token_aqui
INFLUX_ORG=smart-court
INFLUX_BUCKET=smart_court

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
