# ==========================================
# Git Ignore - Quadra Inteligente (IoT)
# ==========================================

# Ambientes virtuais e Python
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
*.tsbuildinfo

# Variáveis de ambiente sensíveis (mantenha os .env.example)
.env
*.env
!.env.example
!backend/.env.example

# Arquivos de debug pesados de compilação C++ (manter .bin e .elf necessários para Wokwi)
*.map
*.merged.bin
build.options.json

# Sistema operacional & IDEs
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!frontend/.vscode/extensions.json
!frontend/.vscode/settings.json
